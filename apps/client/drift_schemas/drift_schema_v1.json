    {
      "name": "servers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"servers\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"server_id\" TEXT NOT NULL UNIQUE, \"name\" TEXT NOT NULL, \"base_url\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"last_used_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "questions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"questions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"server_ref\" INTEGER NULL REFERENCES servers (id) ON DELETE SET NULL, \"image_path\" TEXT NULL, \"ocr_text\" TEXT NOT NULL, \"question_text\" TEXT NOT NULL, \"options_json\" TEXT NOT NULL, \"answer_json\" TEXT NOT NULL, \"provider\" TEXT NOT NULL, \"model\" TEXT NOT NULL, \"confidence\" REAL NOT NULL, \"confidence_level\" TEXT NOT NULL, \"request_id\" TEXT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "drafts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"drafts\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"image_path\" TEXT NULL, \"ocr_text\" TEXT NOT NULL, \"question_text\" TEXT NOT NULL, \"options_json\" TEXT NOT NULL, \"send_image\" INTEGER NOT NULL DEFAULT 0 CHECK (\"send_image\" IN (0, 1)), \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
